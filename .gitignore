# working directory: a `make dev` run writes avatars and dumps here.
/uploads/
/backups/

# --- IDE / OS / Tooling ---
.idea/
.vscode/
.claude/
.playwright-mcp/
*.swp
.DS_Store
Thumbs.db

# Local Uptime-Kuma DBs used for import testing (never commit user data)
kuma.db
*.kuma.db
kuma.db-shm
kuma.db-wal
db-config.json
